# ==============================================================================
# AUTOVERSE FRONTEND — ENVIRONMENT VARIABLES (VERCEL PRODUCTION)
# ==============================================================================
# IMPORTANT:
# - Only variables prefixed with NEXT_PUBLIC_ are bundled into client-side JS.
# - NEVER put MONGODB_URI, JWT_SECRET, or backend private keys in this file.
# ==============================================================================

# Backend REST API Base URL (Live production Node.js/Express service URL on Render, Railway, AWS, etc.)
NEXT_PUBLIC_API_URL=https://api.autoverse.com/api/v1

# Public CDN / S3 Asset URL for vehicle media
NEXT_PUBLIC_CDN_BASE_URL=https://media.autoverse.com

# Site URL for canonical metadata & OG tags
NEXT_PUBLIC_SITE_URL=https://autoverse.vercel.app

